    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@wfe/core": "0.1.0",
    "@wfe/sdk": "0.1.0",
    "@wfe/server": "0.1.0",
    "@testcontainers/postgresql": "^12.1.0",
