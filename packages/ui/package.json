{
  "name": "@wfe/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^24.0.0" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
